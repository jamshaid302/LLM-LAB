# Copy to backend/.env and edit. Every value here has a working default in
# src/core/config.js, so .env is optional until you want to deviate.

# --- Ollama ---
# On the host this is localhost. The API container uses http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
# A chat call gives up after this many milliseconds, then tries once more.
OLLAMA_TIMEOUT_MS=120000
# Primary chat model. qwen2.5:7b gives far better grounding than a 1b model.
# Drop to llama3.2:1b if you need speed over quality.
CHAT_MODEL=qwen2.5:7b
# AI Agents only. Kept separate so the chat model can stay small.
AGENT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- RAG module ---
RAG_TOP_K=3
# Drop retrieved chunks below this cosine similarity. Real matches in this
# corpus score about 0.7-0.8; unrelated chunks score about 0.4.
RAG_MIN_SCORE=0.5
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50
# memory = original in-process store, rebuilt on every restart.
# chroma = persistent vector database. Start it with: docker compose up -d
RAG_STORE=chroma
CHROMA_URL=http://localhost:8000

# --- Reranker ---
# cross-encoder rescores the top RERANK_CANDIDATES vector hits and keeps RAG_TOP_K.
# It raised recall@3 from 0.959 to 1.0 on eval/questions.json. off keeps vector order.
# The model (about 23 MB) downloads once into backend/.cache/models on the first question.
RAG_RERANK=cross-encoder
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# --- Conversations ---
# Threads and messages. This is not the vector database. Chroma holds the
# knowledge-base chunks; MongoDB holds who said what, in order.
MONGO_URL=mongodb://127.0.0.1:27018/lab
CONVERSATION_HISTORY_LIMIT=12

# --- Port ---
API_PORT=5001

# Shared budget for ask, stream, and upload. Counts reset when the API restarts.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Lab login. local and guest are created when those accounts are missing.
# A new account is created from the login form. Accounts stay in MongoDB.
LAB_LOCAL_PASSWORD=local
LAB_GUEST_PASSWORD=guest
LAB_SESSION_SECRET=lab-dev-session
LAB_LOGIN_MAX=8
LAB_LOGIN_WINDOW_MS=60000

# inprocess embeds inside the API. external leaves jobs for: npm run worker
EMBED_WORKER=inprocess
