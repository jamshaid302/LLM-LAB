# Copy to backend/.env and edit. Every value here has a working default in
# src/core/config.js, so .env is optional until you want to deviate.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Primary chat model. qwen2.5:7b gives far better grounding than a 1b model.
# Drop to llama3.2:1b if you need speed over quality.
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- RAG module ---
RAG_TOP_K=3
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50

# --- Port ---
API_PORT=5000
